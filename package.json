{
  "name": "olanga-control",
  "version": "1.3.1",
  "description": "Olanga - Your AI Voice Assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"tests/unit/*.test.js\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "check": "node scripts/check.js",
    "smoke": "electron tests/electron-smoke.js --hidden",
    "smoke:overlay": "electron tests/status-overlay-smoke.js",
    "smoke:overlay:native": "electron tests/status-overlay-lifecycle.js",
    "smoke:desktop": "electron tests/desktop-edit-smoke.js",
    "smoke:voice": "electron tests/voice-command-smoke.js",
    "smoke:voice:audio": "electron tests/voice-command-smoke.js --live-audio",
    "verify:package": "node scripts/verify-package.js"
  },
  "keywords": [
    "ai",
    "voice",
    "assistant"
  ],
  "author": "Aarav",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^36.3.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "vosk-browser": "^0.0.8"
  },
  "build": {
    "appId": "com.aarav.olanga",
    "productName": "Olanga",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "status-indicator.html",
      "status-indicator-preload.js",
      "icon.png",
      "js/**/*",
      "shared/**/*",
      "node_modules/**/*",
      "status-indicator.css",
      "status-indicator.js",
      "desktop-workflows.css",
      "desktop/**/*"
    ],
    "extraResources": [
      {
        "from": "vosk-model-v2.tar.gz",
        "to": "vosk-model-v2.tar.gz"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "Olanga-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Olanga",
      "uninstallDisplayName": "Olanga"
    },
    "asarUnpack": [
      "desktop/*.ps1"
    ]
  }
}
