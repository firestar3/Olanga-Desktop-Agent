{
  "name": "olanga-control",
  "version": "1.0.0",
  "description": "Olanga - Your AI Voice Assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"tests/unit/*.test.js\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "ai",
    "voice",
    "assistant"
  ],
  "author": "Aarav",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^36.3.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "vosk-browser": "^0.0.8"
  },
  "build": {
    "appId": "com.aarav.olanga",
    "productName": "Olanga",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "status-indicator.html",
      "status-indicator-preload.js",
      "icon.png",
      "js/**/*",
      "shared/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "vosk-model-v2.tar.gz",
        "to": "vosk-model-v2.tar.gz"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "Olanga-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Olanga",
      "uninstallDisplayName": "Olanga"
    }
  }
}
